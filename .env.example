# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Frontend origin(s) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────
MONGODB_URL=mongodb://127.0.0.1:27017/doctor-tracker

# ── Auth ───────────────────────────────────────────────
# Use long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# Refresh-token cookie. Use `none` + COOKIE_SECURE=true when the API is
# called cross-site (different domain) over HTTPS.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ── Seed (npm run seed) ────────────────────────────────
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@doctortracker.com
ADMIN_PASSWORD=Admin@12345
