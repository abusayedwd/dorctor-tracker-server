# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Frontend origin(s) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────
MONGODB_URL=mongodb://127.0.0.1:27017/doctor-tracker

# ── Auth ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use two DIFFERENT secrets for access and refresh tokens.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# Refresh-token cookie policy.
# For local dev: lax + false. Behind HTTPS: none + true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ── Seed (npm run seed) ────────────────────────────────
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@doctortracker.com
ADMIN_PASSWORD=Admin@12345
